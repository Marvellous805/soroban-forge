{
  "version": "0.2.0",
  "name": "@soroban-forge/escrow-client",
  "description": "Unified TypeScript SDK with generated clients for all six Soroban Forge contracts",
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/Meet-hybrid/soroban-forge"
  },
  "type": "module",
  "exports": "./dist/index.js",
  "typings": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "generate": "node scripts/generate.mjs",
    "generate:clients": "node scripts/generate.mjs",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "tsc && tsc --project tsconfig.test.json && node --test dist-test/tests/escrow-client.test.js",
    "verify:testnet": "npm run build && tsc --project tsconfig.scripts.json && node dist-scripts/verify-testnet.js"
  },
  "dependencies": {
    "@stellar/stellar-sdk": "^16.0.1",
    "buffer": "6.0.3"
  },
  "devDependencies": {
    "@types/node": "18.19.100",
    "typescript": "^5.6.2"
  }
}
